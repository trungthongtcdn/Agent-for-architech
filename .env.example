# ===== Ứng dụng =====
NEXT_PUBLIC_APP_NAME=ArchRender
# URL công khai (https://... thì cookie đăng nhập tự bật Secure)
APP_URL=http://localhost:3000
# Cổng trên VPS khi chạy docker compose (chỉ nghe 127.0.0.1, đi qua reverse proxy)
APP_PORT=3010
# APP_BIND=0.0.0.0   # bật nếu KHÔNG dùng reverse proxy và muốn vào thẳng http://IP:APP_PORT

# ===== Gemini API (https://aistudio.google.com/apikey — cần bật thanh toán để dùng ảnh 2K/4K và video) =====
# Để trống => chế độ DEMO: ảnh/video giả lập, không tốn tiền
GEMINI_API_KEY=
# Model mặc định (đổi khi Google ra bản mới):
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# GEMINI_IMAGE_PRO_MODEL=gemini-3-pro-image
# GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
# Model văn bản cho nút "AI viết câu lệnh"
# GEMINI_TEXT_MODEL=gemini-3.8-flash

# ===== Tài khoản admin (tạo tự động khi khởi động) =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=doi-mat-khau-nay
# Email khác được cấp quyền admin khi đăng ký (cách nhau dấu phẩy)
# ADMIN_EMAILS=a@x.com,b@y.com

# ===== Nạp credit thủ công =====
SIGNUP_BONUS_CREDITS=30
# Mã ngân hàng theo VietQR: vcb, tcb, mb, acb, bidv, vpb, tpb, vib...
BANK_ID=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
SUPPORT_CONTACT=Zalo 09xx xxx xxx

# ===== Giới hạn =====
# JOB_CONCURRENCY=3
# VIDEO_CONCURRENCY=2
# MAX_ACTIVE_JOBS_PER_USER=3
# MAX_UPLOAD_MB=15
# Số lượt "AI viết câu lệnh" miễn phí mỗi người/ngày
# PROMPT_ASSIST_DAILY_LIMIT=50
